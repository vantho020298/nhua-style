---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Img from '../../components/Img.astro';
import { t } from '../../i18n/ui';
import { contextPaths, bookingUrl, url, type Ctx } from '../../lib/routes';
import { pages, tidyPage } from '../../lib/data';

export function getStaticPaths() {
  return contextPaths();
}
const { ctx } = Astro.props as { ctx: Ctx };
const { lang } = ctx;
const page = pages.about[lang] ?? pages.about.en!;
const lead = page.body.match(/^[^<]*<h2>([^<]*)<\/h2>/)?.[1];
---
<Layout ctx={ctx} path="about" title={t(lang, 'about')} description={lead}>
  <PageHead ctx={ctx} title={t(lang, 'about')} lead={lead} />
  <div class="container" style="padding-bottom: 40px;">
    <div class="hero-img" style="aspect-ratio: 21 / 9;"><Img src="team.jpg" alt="The Nhựa team" loading="eager" widths={[800, 1200, 1600]} sizes="(max-width: 1248px) 100vw, 1200px" /></div>
  </div>
  <section class="container stack" style="gap: 32px; padding-bottom: var(--section);">
    <div class="prose" set:html={tidyPage(page.body)} />
    <div class="row" style="gap: 12px;">
      <a class="btn btn-primary" href={bookingUrl(ctx)}>{t(lang, 'bookNow')}</a>
      <a class="btn btn-ghost" href={url(ctx, 'locations')}>{t(lang, 'locations')}</a>
    </div>
  </section>
</Layout>
