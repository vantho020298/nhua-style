---
// Nhựa Style's homepage, laid out like its printed menu: haircut price box, dotted-leader price
// lists, then the combos (navy and oxblood panels for the top two, as on the paper menu).
import Img from '../Img.astro';
import { t } from '../../i18n/ui';
import { url, bookingUrl, type Ctx } from '../../lib/routes';
import { servicesIn, serviceByKey, branches, displayName, durationLabel, servicePrice, sentence, formatPhone, telHref } from '../../lib/data';

interface Props { ctx: Ctx; }
const { ctx } = Astro.props;
const { lang } = ctx;
const haircut = serviceByKey('cat-toc');
const nameOf = (key: string) => displayName(serviceByKey(key).t[lang].name);
const strip: [string, string][] = [['cut-quiff.jpg', 'cat-toc'], ['barber-work.jpg', 'cat-toc'], ['cut-color.jpg', 'cat-toc'], ['cut-side.jpg', 'cat-toc']];
const combos = servicesIn('signature');
// The two dearest packages get the coloured panels, oxblood then navy as on the paper menu.
const panelled = combos.slice(-2).map((s) => s.key);
const panel = (key: string) => (key === panelled[0] ? 'red' : key === panelled[1] ? 'navy' : '');
const lists = [
  { g: 'single' as const, items: servicesIn('single') },
  { g: 'relax' as const, items: servicesIn('relax'), note: t(lang, 'groupLead_relax') },
  { g: 'chemical' as const, items: servicesIn('chemical') },
].filter((l) => l.items.length);
---
<section class="container hero">
  <div class="stack hero-text">
    <p class="eyebrow">{t(lang, 'homeEyebrow')}</p>
    <h1 class="display">{t(lang, 'menu_title')}</h1>
    <p class="lead">{t(lang, 'menu_lead')} <a class="u nowrap" href={telHref(branches[0].phone)}>☎ {formatPhone(branches[0].phone)}</a></p>
    <a class="price-chip display" href={bookingUrl(ctx, { service: haircut.key })}>{displayName(haircut.t[lang].name)} · {servicePrice(haircut, lang)}</a>
    <div class="row" style="gap: 12px;">
      <a class="btn btn-primary" href={bookingUrl(ctx)}>{t(lang, 'bookNow')}</a>
      <a class="btn btn-ghost" href="#menu">{t(lang, 'menu_head')}</a>
    </div>
  </div>
  <div class="hero-art">
    <Img class="cover photo" src="cut-fade.jpg" alt={nameOf('cat-toc')} loading="eager" priority widths={[400, 800]} sizes="(max-width: 640px) 90vw, 480px" />
    <Img class="badge" src="logo-style.jpg" alt="Nhựa Style logo" loading="eager" widths={[200, 400]} sizes="180px" />
    <a class="haircut" href={bookingUrl(ctx, { service: haircut.key })}>
      <span class="display">{displayName(haircut.t[lang].name)}</span>
      <strong class="display">{servicePrice(haircut, lang)}</strong>
    </a>
  </div>
</section>

<section id="menu" class="container section stack" style="gap: 40px; padding-top: clamp(24px, 4vw, 56px);">
  <div class="menu-head">
    <span class="pole" aria-hidden="true"></span>
    <h2 class="display">{t(lang, 'menu_head')}</h2>
    <span class="pole" aria-hidden="true"></span>
  </div>
  <p class="muted" style="text-align: center; margin-top: -24px;">{t(lang, 'pricesNote')}</p>

  <div class="sheet">
    {lists.map(({ g, items, note }) => (
      <section class:list={['stack', `list-${g}`]} style="gap: 8px;">
        <h3 class="display">{t(lang, `group_${g}`)}</h3>
        {note && <p class="list-note">{note}</p>}
        <ul class="leaders">
          {items.map((s) => (
            <li>
              <a class:list={{ range: !!s.priceTo }} href={url(ctx, `services/${s.key}`)}>
                <span class="nm"><span>{displayName(s.t[lang].name)}</span><span class="dots" aria-hidden="true"></span></span>
                <span class="amt">{servicePrice(s, lang)}</span>
                {g === 'relax' && <span class="inc">{s.t[lang].includes.map(sentence).join(' · ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="stack" style="gap: 6px; align-items: center;">
    <h3 class="display sub">{t(lang, 'group_signature')}</h3>
  </div>
  <ol class="combos">
    {combos.map((s) => (
      <li class:list={['combo', panel(s.key)]}>
        <div class="combo-name">
          <h3 class="display"><a href={url(ctx, `services/${s.key}`)}>{displayName(s.t[lang].name)}</a></h3>
          <p class="combo-price display">{servicePrice(s, lang)}</p>
          {durationLabel(s, lang) && <p class="combo-time">{durationLabel(s, lang)}</p>}
          <a class="btn btn-sm combo-book" href={bookingUrl(ctx, { service: s.key })} aria-label={`${t(lang, 'bookThis')}: ${displayName(s.t[lang].name)}`}>{t(lang, 'bookThis')} →</a>
        </div>
        <ul class:list={['combo-items', { few: s.t[lang].includes.length <= 3 }]}>
          {s.t[lang].includes.map((item) => <li>{sentence(item)}</li>)}
        </ul>
      </li>
    ))}
  </ol>

  <div class="row" style="gap: 12px; justify-content: center;">
    <a class="btn btn-primary" href={bookingUrl(ctx)}>{t(lang, 'bookNow')}</a>
  </div>
</section>

<section class="strip" aria-label={t(lang, 'gallery')}>
  {strip.map(([file, key]) => (
    <Img class="cover" src={file} alt={nameOf(key)} widths={[400, 700]} sizes="(max-width: 640px) 50vw, 25vw" />
  ))}
</section>

<section class="visit">
  <div class="container section visit-grid">
    {branches.map((b) => (
      <div class="stack" style="gap: 10px;">
        <h3 class="display" lang="vi">{b.name}</h3>
        <p>{b.address}</p>
        <p><a class="u" href={telHref(b.phone)}>{formatPhone(b.phone)}</a> · <a class="u" href={b.mapUrl} rel="noopener">{t(lang, 'directions')}</a></p>
      </div>
    ))}
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: 64px; padding-bottom: 72px; }
  .hero-text { flex: 1 1 520px; gap: 24px; }
  .hero h1 { font-size: clamp(38px, 5.4vw, 72px); line-height: 1.08; hyphens: manual; }
  .hero-art { flex: 1 1 380px; position: relative; height: clamp(420px, 44vw, 560px); }
  .hero-art :global(.photo) { position: absolute; right: 0; top: 0; width: 82%; height: 88%; border-radius: var(--radius); }
  .hero-art :global(.badge) { position: absolute; left: 0; top: 24px; width: clamp(120px, 14vw, 170px); aspect-ratio: 1; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 6px var(--bg); }
  .haircut { position: absolute; left: 4%; bottom: 0; display: grid; gap: 2px; padding: 18px 28px 14px; background: var(--navy); color: var(--bg); border-radius: var(--radius); box-shadow: 0 0 0 6px var(--bg); text-align: center; }
  .haircut span { font-size: 20px; letter-spacing: .04em; }
  .haircut strong { font-size: clamp(40px, 4.6vw, 60px); line-height: 1; color: var(--bg); text-shadow: 3px 3px 0 #D8352A; }

  .menu-head { display: flex; align-items: center; justify-content: center; gap: 20px; }
  .menu-head h2 { font-size: clamp(40px, 8vw, 96px); line-height: 1; letter-spacing: .06em; white-space: nowrap; }
  .pole { width: 18px; height: 64px; border-radius: 9px; border: 3px solid var(--text); background: repeating-linear-gradient(-35deg, var(--red) 0 7px, #fff 7px 12px, var(--navy) 12px 19px, #fff 19px 24px); }

  .combos { list-style: none; padding: 0; display: grid; gap: 20px; }
  .combo { display: grid; grid-template-columns: minmax(200px, 260px) 1fr; gap: 12px 40px; align-items: center; padding: 28px 32px; border-radius: var(--radius); border: 1px solid var(--line); }
  .combo h3 { font-size: clamp(26px, 2.8vw, 34px); line-height: 1.05; color: var(--red); }
  .combo h3 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .combo-price { font-size: clamp(30px, 3.2vw, 40px); color: var(--navy); margin-top: 6px; }
  .combo-time { font-size: 16px; color: var(--muted); }
  .combo-items { columns: 2 220px; column-gap: 40px; padding-left: 1.1em; font-size: 16px; line-height: 1.5; }
  .combo-items li { break-inside: avoid; padding-block: 3px; }
  .combo-items.few { columns: 1; }
  .combo { align-items: start; }
  .price-chip { display: none; align-self: flex-start; padding: 8px 18px; border-radius: 999px; background: var(--navy); color: var(--bg); font-size: 20px; }
  /* Phones held sideways: the photo and price badge sit below the fold, so show the price up top. */
  /* Phones (and phones held sideways) see the price before the photo badge scrolls into view. */
  @media (max-width: 640px), (orientation: landscape) and (max-height: 500px) { .price-chip { display: inline-block; } }
  @media (orientation: landscape) and (max-height: 500px) {
    .hero { padding-top: 24px; gap: 24px; }
    .hero-text { gap: 14px; }
    .hero h1 { font-size: 34px; }
  }
  :global(html[lang="ja"]) .hero h1 { word-break: keep-all; line-break: strict; }
  .combo-book { margin-top: 12px; border-color: currentColor; color: var(--navy); background: transparent; }
  .combo.red .combo-book, .combo.navy .combo-book { color: var(--bg); }
  .combo h3 { line-height: 1.15; hyphens: manual; }
  .combo.red, .combo.navy { border: 0; color: var(--bg); }
  .combo.red { background: var(--red-deep); }
  .combo.navy { background: var(--navy); }
  .combo.red :is(h3, .combo-price, .combo-time), .combo.navy :is(h3, .combo-price, .combo-time) { color: var(--bg); }
  .combo.red .combo-price, .combo.navy .combo-price { color: #F6C9A8; }
  .combos { margin-top: -16px; }
  .sub { font-size: clamp(28px, 3vw, 36px); color: var(--red); text-align: center; }

  .sheet { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 40px 56px; padding: 40px clamp(20px, 4vw, 48px); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .sheet h3 { font-size: 24px; color: var(--red); }
  .leaders { list-style: none; padding: 0; }
  /* Name, dotted leader, price; a long range price drops to its own line instead of squeezing the name. */
  /* Name (wrapping if long) with a dotted leader after its last line, price on the same line. */
  .leaders a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 8px; padding-block: 8px; }
  .leaders a:hover .nm > span:first-child { text-decoration: underline; text-underline-offset: 4px; }
  .leaders .nm { display: flex; align-items: flex-end; gap: 8px; min-width: 0; }
  .leaders .dots { flex: 1 0 16px; margin-bottom: .35em; border-bottom: 2px dotted var(--line-strong); opacity: .45; }
  .leaders .amt { white-space: nowrap; font-weight: 600; color: var(--navy); font-variant-numeric: tabular-nums; }
  .leaders .inc { grid-column: 1 / -1; font-size: 16px; color: var(--muted); line-height: 1.45; }
  :global(html[lang="ja"]) :is(.leaders, .combo-items) { word-break: auto-phrase; overflow-wrap: anywhere; }
  /* Narrow screens: a price range gets its own line under the name instead of squeezing it. */
  @media (max-width: 420px) {
    .leaders a.range { grid-template-columns: minmax(0, 1fr); }
    .leaders a.range .amt { justify-self: end; }
  }
  @media (max-width: 340px) { .leaders a { grid-template-columns: minmax(0, 1fr); } .leaders .amt { justify-self: end; } }
  :global(html[lang="ko"]) .leaders .nm span { overflow-wrap: normal; }
  @media (max-width: 640px) { .haircut { display: none; } }
  .visit a { display: inline-block; padding-block: 10px; }
  .visit :focus-visible { outline-color: var(--bg); }
  @media (min-width: 721px) { .combo:has(.few) { grid-template-columns: minmax(200px, 260px) minmax(0, 1fr); } }
  .list-note { font-size: 15px; color: var(--muted); margin-top: -4px; }
  /* Single services fill the left column; relax combos and perm/colour stack on the right. */
  @media (min-width: 760px) {
    .sheet { grid-template-columns: 1fr 1fr; }
    .list-single { grid-row: span 2; }
  }
  /* Oswald stacks Vietnamese marks (Ể, Ẩ) well above the capitals: leave room so lines do not touch. */
  :global(html[lang="vi"]) .hero h1 { line-height: 1.3; }
  @media (max-width: 340px) { .hero h1 { font-size: 30px; } }

  .strip { display: grid; grid-template-columns: repeat(4, 1fr); }
  .strip :global(img) { height: 360px; }

  .visit { background: var(--red-deep); color: var(--bg); }
  .visit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 40px; }
  .visit h3 { font-size: 26px; line-height: 1.25; color: #F6C9A8; }
  .visit p { line-height: 1.6; }
  .u { text-decoration: underline; text-underline-offset: 4px; font-weight: 600; }

  @media (max-width: 720px) {
    .combo { grid-template-columns: 1fr; padding: 24px 20px; }
    .strip { grid-template-columns: 1fr 1fr; }
    .strip :global(img) { height: 220px; }
    .pole { height: 48px; width: 14px; }
  }
</style>
