---
import { t } from '../i18n/ui';
import { url, type Ctx } from '../lib/routes';

interface Props {
  ctx: Ctx;
  title: string;
  lead?: string;
  /** Parent pages between Home and this one. */
  trail?: { label: string; path: string }[];
}
const { ctx, title, lead, trail = [] } = Astro.props;
---
<header class="container page-head">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={url(ctx)}>{t(ctx.lang, 'home')}</a>
    {trail.map((c) => (<><span aria-hidden="true">/</span><a href={url(ctx, c.path)}>{c.label}</a></>))}
    <span aria-hidden="true">/</span><span aria-current="page">{title}</span>
  </nav>
  <h1 class="display h1">{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
