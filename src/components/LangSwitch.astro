---
import { LANGS, LANG_META } from '../i18n/langs';
import { t } from '../i18n/ui';
import { switchLang, type Ctx } from '../lib/routes';

interface Props { ctx: Ctx; path: string; }
const { ctx, path } = Astro.props;
---
<details class="dropdown">
  <summary aria-label={t(ctx.lang, 'language')}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
    <span>{LANG_META[ctx.lang].short}</span>
  </summary>
  <div class="dropdown-panel">
    {LANGS.map((l) => (
      <a href={switchLang(ctx, l, path)} hreflang={LANG_META[l].html} lang={LANG_META[l].html} aria-current={l === ctx.lang ? 'true' : undefined}>
        {LANG_META[l].label}
      </a>
    ))}
  </div>
</details>
